## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
.vscode/

# Visual Studio Code workspace settings
*.code-workspace

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet
*.nupkg
*.snupkg
*.nuget/
packages/
*.config
NuGet.config

# SQL Server files
*.mdf
*.ldf
*.ndf

# Entity Framework Core Migrations snapshots
Migrations/*Designer.cs
Migrations/*Snapshot.cs

# Dotnet publish output
/bin/
/obj/
/out/
/publish/

# Dotnet global tool config
.dotnet/

# Environment files (secrets)
*.env
*.env.local
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
secrets.json

# Rider
.idea/

# Logs
*.log

# IIS Express
/.vs/
iisexpress/
*.dbmdl
*.bak
*.log

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# Backup & temp files
*.tmp
*.temp
*.bak
*.old
*.orig

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Linux
*~
